doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Assets Managment System
        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
        link(rel="stylesheet", href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.min.css")

        block styles
    body.bg-light
        div.d-flex.min-vh-100
            nav#sidebar.bg-dark.text-white.p-3.d-flex.flex-column(style="width: 260px; flex-shrink: 0;")
                a.d-flex.align-items-center.mb-3.mb-md-0.me-md-auto.text-white.text-decoration-neon(href="/")
                    i.bi.bi-box-seam.fs-4.me-2.text-primary
                    span.fs-5.fw-bold KTT Assets 

                hr.text-secondary

                ul.nav.nav-pills.flex-column.mb-auto
                    li.nav-item.mb-1
                        a.nav-link.text-white(href="/assets/stock-view")
                            i.bi.bi-speedometer2.me-2
                            | Stock View    
                    li.nav-item.mb-1 
                        a.nav-link.text-white(href="/assets")
                            i.bi.bi-laptop.me-2 
                            | Asset Master 
                    li.nav-item.mb-1 
                        a.nav-link.text-white(href="/employees")
                            i.bi.bi-people.me-2
                            | Employee Master 
                    li.nav-item.text-white.mb-1 
                        a.nav.link.text-white(href="/categories")
                            i.bi.bi-tags.me-2
                            | Category Master 
            
                hr.text-secondary
                div.small.text-secondary.text-center Asset Management v1.0 

            div.flex-grow-1.d-flex.flex-column.overflow-auto
                header.bg-white.shadow-sm.py-3.mb-4.d-flex.justify-content-between.align-items-center.px-4
                    h5.mb-0.text-secondary.fw-normal Enterprise Portal
                    span.badge.bg-primary.bg-opacity-10.text-primary.px-3.py-2 System Active 
                
                main.px-4.pb-5.flex-grow-1 
                    block content
       
        script(src="https://code.jquery.com/jquery-3.7.1.min.js")
        
        script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
        
        script(src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js")
        
        script(src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.min.js")

        block scripts

