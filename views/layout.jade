doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Assets Management System
        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
        link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
        link(rel="stylesheet", href="https://cdn.datatables.net/2.0.8/css/dataTables.bootstrap5.min.css")

        block styles
    body.bg-light
        div.d-flex.min-vh-100
            nav#sidebar.bg-dark.text-white.d-flex.flex-column.p-4.shadow-lg(style="width:260px;")
                a.d-flex.align-items-center.gap-2.mb-4.pb-3.border-bottom.border-secondary.text-white.text-decoration-none(href="/")
                    i.bi.bi-box-seam.fs-4.me-2.text-primary
                    span.fs-8.fw-semibold KTT Assets Management

                ul.nav.nav-pills.flex-column.mb-auto.gap-2
                    li.nav-item
                        a.nav-link.text-white.py-2.px-3.rounded-3(href="/assets/stockView")
                            i.bi.bi-speedometer2.me-2
                            | Stock View
                    li.nav-item
                        a.nav-link.text-white.py-2.px-3.rounded-3(href="/assets")
                            i.bi.bi-laptop.me-2
                            | Asset Master
                    li.nav-item
                        a.nav-link.text-white.py-2.px-3.rounded-3(href="/employees")
                            i.bi.bi-people.me-2
                            | Employee Master
                    li.nav-item
                        a.nav-link.text-white.py-2.px-3.rounded-3(href="/categories")
                            i.bi.bi-tags.me-2
                            | Category Master
                    li.nav-item
                        a.nav-link.text-white.py-2.px-3.rounded-3(href="/getAssetHistory")
                            i.bi.bi-clock-history.me-2
                            | Asset History

                hr.border-secondary.opacity-25
                div.small.text-secondary.text-center.mt-3 Asset Management v1.0

            div.flex-grow-1.d-flex.flex-column.overflow-hidden
                header.bg-white.shadow-sm.py-3.mb-4.d-flex.justify-content-between.align-items-center.px-4
                    h5.mb-0.text-secondary.fw-normal Enterprise Portal
                    span.badge.bg-primary.bg-opacity-10.text-primary.px-3.py-2 System Active 
                
                main.px-4.pb-5.flex-grow-1 
                    block content
       
        script(src="https://code.jquery.com/jquery-3.7.1.min.js")
        
        script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
        
        script(src="https://cdn.datatables.net/2.0.8/js/dataTables.min.js")
        
        script(src="https://cdn.datatables.net/2.0.8/js/dataTables.bootstrap5.min.js")

        script.
            (function(){
                var currentPage = window.location.pathname;
                var sidebarLinks = document.querySelectorAll('#sidebar .nav-link');
                sidebarLinks.forEach(function(link){
                    var linkPath = link.getAttribute('href');
                    if(linkPath === currentPage){
                        link.classList.add('active');
                    }
                });
            })();

        block scripts

