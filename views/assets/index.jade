extends ../layout
include ../components/modals

block content

    div.d-flex.justify-content-between.align-items-center.mb-4
        div 
            h3.fw-bold.text-dark.mb-1 Assets view 
            p.text-secondary.small.mb-0 Manage Your Assets with Valid Crendentials
        button.btn.btn-primary.btn-sm(type="button", data-bs-toggle="modal", data-bs-target="#addAssetModal") + Add New Asset 
    
    div.card.border-0.shodow-md
        div.card-body.p-4
            table#assetTable.table.table-striped.table-hover.w-100
                thead.table-light
                    tr 
                        th.text-left Sr. No.
                        th.text-left Make 
                        th.text-center Model 
                        th.text-center Value
                        th.text-center Branch 
                        th.text-left Purchased
                        th.text-center Status
                        th.text-right Actions
                tbody 

    +formModal('addAssetModal', 'Create New Asset', 'assetForm', 'Save Asset')
        input#originalAssetId(type="hidden", name="originalAssetId", value="")
        input#originalSerialNumber(type="hidden", name="originalSerialNumber", value="")
        div.row.g-3.pt-1
            div.col-md-6
                label.form-label.small.fw-semibold.text-secondary.mb-1 Serial Number
                input.form-control.form-control-sm.shadow-none(type="text", name="serialNumber", required)
            div.col-md-6
                label.form-label.small.fw-semibold.text-secondary.mb-1 Category Name
                input.form-control.form-control-sm.shadow-none(type="text", name="Cname", required)
            div.col-md-6
                label.form-label.small.fw-semibold.text-secondary.mb-1 Make
                input.form-control.form-control-sm(type="text", name="make", required)
            div.col-md-6
                label.form-label.small.fw-semibold.text-secondary.mb-1 Model 
                input.form-control.form-control-sm(type="text", name="model", required)
            div.col-md-6
                label.form-label.small.fw-semibold.text-secondary.mb-1 Value (Rs)
                input.form-control.form-control-sm(type="text", name="value", required)
            div.col-md-6
                label.form-label.small.fw-semibold.text-secondary.mb-1 Branch 
                input.form-control.form-control-sm(type="text", name="branch", required)
            div.col-md-6
                label.form-label.small.fw-semibold.text-secondary.mb-1 Purchased Date
                input.form-control.form-control-sm(type="date", name="purchasedDate", required)
            div.col-md-12
                label.form-label.small.fw-semibold.text-secondary.mb-1 status
                select.form-select.form-select-sm.shadow-none(name="status", required)
                    option(value="in_stock", selected) In_Stock 
                    option(value="issued") Issued 
                    option(value="scrapped") Scrapped
                    

    +formModal('issueAssetModal', 'Issue Asset to Employee', 'issueAssetForm', 'Confirm Issuance')
        input#issueAssetId(type="hidden", name="assetId", value="")
        div.row.g-3.pt-1
            div.col-md-12
                label.form-label.small.fw-semibold.text-secondary.mb-1 Employee ID or Email
                input#empSearchInput.form-control.form-control-sm.shadow-none(type="text", list="empDatalist", placeholder="Start typing for emp id/email....")
                datalist#empDatalist

            div.col-md-12
                label.form-label.small.fw-semibold.text-secondary.mb-1 Reason
                textarea#issueRemarks.form-control.form-control-sm.shadow-none(name="remarks", rows="3", placeholder="e.g., Assigned for remote development work...")


    +formModal('returnAssetModal', 'Return Asset', 'returnAssetForm', 'Confirm Return')
        input#returnAssetId(type="hidden", name="assetId", value="")
        div.row.g-3.pt-1
            div.col-md-12
                label.form-label.small.fw-semibold.text-secondary.mb-1 Asset Serial Number
                input#returnAssetSerialNumber.form-control.form-control-sm.shadow-none(type="text", readonly)
            div.col-md-12
                label.form-label.small.fw-semibold.text-secondary.mb-1 Assigned Employee
                input#returnEmployeeDisplay.form-control.form-control-sm.shadow-none(type="text", readonly)
            div.col-md-12
                label.form-label.small.fw-semibold.text-secondary.mb-1 Reason for Return
                textarea#returnReason.form-control.form-control-sm.shadow-none(name="reason", rows="3", placeholder="e.g., Asset returned for replacement or repair")

    +confirmModal('scrapAssetConfirmModal', 'Confirm Scrap', 'This action will mark the selected asset as scrapped and cannot be undone.', 'Confirm Scrap', 'btn-danger', 'confirmScrapAssetBtn')
        div.mt-2
            p.mb-1.fw-semibold.text-dark Asset Serial Number
            input#scrapAssetSerialNumber.form-control.form-control-sm.shadow-none(type="text", readonly)
            p.mb-1.mt-3.fw-semibold.text-dark Reason
            textarea#scrapReason.form-control.form-control-sm.shadow-none(rows="3", placeholder="Provide scrap reason")

block scripts 
    script. 
        var assetTable;
        var pendingScrapAssetId = null;
        var pendingScrapSerialNumber = null;

        var API_GET_URL = '/api/assets/getAssets'
        var API_CREATE_URL = '/api/assets/addAssets'
        var API_UPDATE_URL = '/api/assets/update/'
        var API_ISSUE_URL = '/api/assets/issue/'
        var API_RETURN_URL = '/api/assets/return/'
        var API_SCRAP_URL = '/api/assets/scrap/'
        
        $(document).ready(function(){
            assetTable = $('#assetTable').DataTable({
                ajax:{
                    url: API_GET_URL,
                    type: 'GET',
                    dataSrc: function(json){
                        if(Array.isArray(json)){
                            return json
                        }

                        return json.assets || json.data || []
                    }
                },

                columns: [
                    {
                        data: 'serialNumber',
                        render: function(data){
                            return '<span class="badge bg-light text-dark border font-monospace px-2 py-1 shadow-sm">' + (data || 'N/A') + '</span>';
                        }
                    },

                    {
                        data: 'make',
                        render: function(data){
                            return '<span class="text-secondary fw-medium text-left">' + (data || '-') + '</span>'
                        }
                    },

                    {
                        data: 'model',
                        className: 'text-center',
                        render: function(data){
                            return '<span class="text-dark fw-semibold">' + data + '</span>'
                        }
                    },

                    {
                        data: 'value',
                        className: 'text-center font-monospace',
                        render: function(data){
                            return '<span class="fw-semibold text-success-emphasis text-center"> Rs.' + data + '</span>'
                        }
                    },

                    {
                        data: 'branch',
                        render: function(data){
                            return '<span class="text-center text-dark"><i class="bi bi-building text-muted me-1"></i>' + (data || 'Main HQ') + '</span>'
                        }
                    },

                    {
                        data: 'purchasedDate',
                        render: function(data){
                            return '<span class="text-secondary small"><i class="bi bi-calendar3 text-muted me-1 text-center"></i>' + data + '</span>'
                        }
                    },

                    {
                        data: 'status',
                        render: function(data){

                            var statusStr = (data).toLowerCase();
                            var badgeClass = 'bg-success-subtle text-success-emphasis border border-success-subtle';
                            var icon = 'bi-check-circle-fill me-1';
                            var label = 'In Stock';

                            if (statusStr === 'issued') {
                                badgeClass = 'bg-warning-subtle text-warning-emphasis border border-warning-subtle';
                                icon = 'bi-exclamation-triangle-fill me-1';
                                label = 'Issued'

                            } else if (statusStr === 'scrapped') {
                                badgeClass = 'bg-danger-subtle text-danger-emphasis border border-danger-subtle';
                                icon = 'bi-x-circle-fill me-1';
                                label = 'Scrapped';
                            }

                            return '<span class="badge rounded-pill ' + badgeClass + ' px-3 py-1 fw-medium">' +
                                   '<i class="bi ' + icon + '"></i>' + label + 
                                   '</span>';
                        }
                    },

                    {
                        render: function(data, type, row){
                            var assetId = row.id || row.Id || '';
                            var statusStr = (row.status || '').toLowerCase();
                            var editBtn = '<button class="btn btn-sm btn-light border shadow-sm btn-edit text-primary fw-medium px-3 py-1 transition-all" title="Edit Asset"><i class="bi bi-pencil-square me-1"></i> Edit </button>';
                            var issueBtn = '';
                            var returnBtn = '';

                            if (statusStr === 'in_stock') {
                                issueBtn = '<button class="btn btn-sm btn-light border shadow-sm btn-issue text-warning fw-medium px-2 py-1 transition-all" title="Issue Asset"><i class="bi bi-person-check"></i></button>';
                            } else if (statusStr === 'issued') {
                                returnBtn = '<button class="btn btn-sm btn-light border shadow-sm btn-return text-warning fw-medium px-2 py-1 transition-all" title="Return Asset"><i class="bi bi-arrow-return-left"></i></button>';
                            }

                            return '<div class="d-flex justify-content-end gap-2">' + editBtn + issueBtn + returnBtn + '</div>';
                        }
                    }
                ],

                order:[[1, 'asc']],
                language:{
                    emptyTable: 'No Assets Found',
                    loadingRecords: '<div class="spinner-border text-primary my-3" role="status"></div>'
                }
            });

            $('#assetTable').on('click', '.btn-edit', function(){
                var tr = $(this).closest('tr');
                var rowData = assetTable.row(tr).data();

                if(rowData){
                    $('#originalAssetId').val(rowData.id || rowData.Id || '');
                    $('#originalSerialNumber').val(rowData.serialNumber)

                    $('input[name="serialNumber"]').val(rowData.serialNumber);
                    $('input[name="make"]').val(rowData.make)
                    $('input[name="model"]').val(rowData.model)
                    $('input[name="value"]').val(rowData.value)
                    $('input[name="branch"]').val(rowData.branch)
                    $('input[name="Cid"]').val(rowData.categoryId)

                    if(rowData.purchasedDate){
                        var d = new Date(rowData.purchasedDate)
                        if(!isNaN(d)){
                            var formatDate = d.toISOString().split('T')[0];
                            $('input[name="purchasedDate"]').val(formatDate);
                        }else{
                            $('input[name="purchasedDate"]').val(rowData.purchasedDate);
                        }
                    }

                    $('select[name="status"]').val(rowData.status || 'in_stock');

                    $('#addAssetModalLabel').text('Update Asset Details');
                    $('#assetForm button[type="submit"]').text('Update Asset');
                    $('#addAssetModal').modal('show');
                }
            });

            $('#assetTable').on('click', '.btn-return', function(){
                var tr = $(this).closest('tr');
                var rowData = assetTable.row(tr).data();
                var assetId = rowData && (rowData.id || rowData.Id || '');

                if(assetId){    
                    $('#returnAssetId').val(assetId);
                    $('#returnAssetSerialNumber').val(rowData.serialNumber || '');

                    var employeeName = rowData.currentHolder && rowData.currentHolder.name ? rowData.currentHolder.name : '';
                    var employeeEmail = rowData.currentHolder && rowData.currentHolder.email ? rowData.currentHolder.email : '';
                    var employeeDisplay = employeeName || employeeEmail || 'No employee assigned';

                    if(employeeName && employeeEmail){
                        employeeDisplay = employeeName + ' (' + employeeEmail + ')';
                    }

                    $('#returnEmployeeDisplay').val(employeeDisplay);
                    $('#returnAssetModalLabel').text('Return Asset - ' + (rowData.serialNumber || 'Asset'));
                    $('#returnAssetModal').modal('show');
                }
            });

            $('#returnAssetForm').on('submit', function(e){
                e.preventDefault();

                var assetId = $('#returnAssetId').val();
                var reason = $('#returnReason').val().trim();

                if(!assetId){
                    alert('Asset ID is missing.');
                    return;
                }

                if(!reason){
                    alert('Please provide a reason for returning the asset.');
                    return;
                }

                var submitBtn = $(this).find('button[type="submit"]');
                var originalBtnText = submitBtn.text();
                submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Processing...');

                $.ajax({
                    url: API_RETURN_URL + encodeURIComponent(assetId),
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ reason: reason }),
                    success: function(response){
                        $('#returnAssetModal').modal('hide');
                        $('#returnAssetForm')[0].reset();
                        if(assetTable){
                            assetTable.ajax.reload(null, false);
                        }
                    },
                    error: function(xhr){
                        var errMsg = 'Unable to return the asset';
                        if(xhr.responseJSON && (xhr.responseJSON.message || xhr.responseJSON.error)){
                            errMsg = xhr.responseJSON.message || xhr.responseJSON.error;
                        }
                        alert('Error: ' + errMsg);
                    },
                    complete: function(){
                        submitBtn.prop('disabled', false).text(originalBtnText);
                    }
                });
            });

            $('#returnAssetModal').on('hidden.bs.modal', function(){
                $('#returnAssetForm')[0].reset();
                $('#returnAssetId').val('');
                $('#returnAssetModalLabel').text('Return Asset');
            });

            $('#addAssetModal').on('hidden.bs.modal', function(){
                $('#assetForm')[0].reset();
                $('#originalSerialNumber').val('')
                $('#addAssetModalLabel').text('Create New Asset')
                $('#assetForm button[type="submit"]').text('Save Asset');
            });

            $('#assetForm').on('submit', function(e){
                e.preventDefault();

                var serialNumber = $('#originalSerialNumber').val();
                var isUpdate = (serialNumber && serialNumber.trim() !== '');

                var formatDataList = $(this).serializeArray();
                var payload = {};
                $.each(formatDataList, function(i, field){
                    if(field.name === 'originalSerialNumber'){
                        return; 
                    }

                    if(field.name === 'Cname'){
                        payload.categoryName = field.value;
                        return;
                    }

                    if(field.name === 'serialNumber'){
                        payload.serialNumber = field.value;
                        return;
                    }

                    payload[field.name] = field.value;
                }); 

                if(payload.value){
                    payload.value = Number(payload.value)
                }

                var isScrap = (payload.status || '').toLowerCase() === 'scrapped';
                if (isScrap && isUpdate) {
                    pendingScrapAssetId = $('#originalAssetId').val();
                    pendingScrapSerialNumber = payload.serialNumber || serialNumber;
                    $('#scrapAssetSerialNumber').val(pendingScrapSerialNumber);
                    $('#scrapAssetConfirmModal').modal('show');
                    return;
                }

                var requestUrl = isUpdate ? (API_UPDATE_URL + encodeURIComponent(serialNumber)) : API_CREATE_URL;
                var requestMethod = isUpdate ? 'PUT' : 'POST'
                var submitBtn = $(this).find('button[type="submit"]');
                var originalBtnText = submitBtn.text();
                submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Saving...');


                $.ajax({
                    url: requestUrl,
                    type: requestMethod,
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function(response){
                        $('#addAssetModal').modal('hide');
                        if(assetTable){
                            assetTable.ajax.reload(null, false);
                        }
                    },

                    error: function(xhr, status, error){
                        var errMsg = 'Failed to process asset request'
                        if(xhr.responseJSON && (xhr.responseJSON.message || xhr.responseJSON.error)){
                            errMsg = xhr.responseJSON.message || xhr.responseJSON.error;
                        }
                        alert('Error ' + errMsg);
                    },

                    complete: function(){
                        submitBtn.prop('disabled', false).text(originalBtnText);
                    }
                });

            });

            $('#confirmScrapAssetBtn').on('click', function(){
                var reason = $('#scrapReason').val().trim();
                var submitBtn = $('#assetForm button[type="submit"]');
                var originalBtnText = submitBtn.text();

                if(!pendingScrapAssetId){
                    $('#scrapAssetConfirmModal').modal('hide');
                    return;
                }

                submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Scrapping...');

                $.ajax({
                    url: API_SCRAP_URL + encodeURIComponent(pendingScrapAssetId),
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ reason: reason || 'Scrapped from asset edit form' }),
                    success: function(response){
                        $('#scrapAssetConfirmModal').modal('hide');
                        $('#addAssetModal').modal('hide');
                        $('#assetForm')[0].reset();
                        $('#scrapReason').val('');
                        if(assetTable){
                            assetTable.ajax.reload(null, false);
                        }
                    },
                    error: function(xhr){
                        var errMsg = 'Failed to scrap asset';
                        if(xhr.responseJSON && (xhr.responseJSON.message || xhr.responseJSON.error)){
                            errMsg = xhr.responseJSON.message || xhr.responseJSON.error;
                        }
                        alert('Error: ' + errMsg);
                    },
                    complete: function(){
                        submitBtn.prop('disabled', false).text(originalBtnText);
                        pendingScrapAssetId = null;
                        pendingScrapSerialNumber = null;
                    }
                });
            });

            $('#assetTable').on('click', '.btn-issue', function(){
                var tr = $(this).closest('tr');
                var rowData = assetTable.row(tr).data();
                var assetId = rowData.id || rowData.Id;

                if(assetId){
                    $('#issueAssetId').val(assetId);
                    $('#issueAssetModal').modal('show');
                }
            });

            $('#issueAssetForm').on('submit', function(e) {
                e.preventDefault();
                var assetId = $('#issueAssetId').val();
                var employeeInput = $('#empSearchInput').val().trim();
                var remarks = $('#issueRemarks').val();

                if(!assetId || !employeeInput){
                    alert('Please enter a valid employee ID or email.');
                    return;
                }

                var payload = {
                    employeeEmail: employeeInput,
                    reason: remarks || 'Issued via portal'
                };

                var submitBtn = $(this).find('button[type="submit"]');
                var originalBtnText = submitBtn.text();
                submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Issuing...');

                $.ajax({
                    url: API_ISSUE_URL + assetId,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function(response){
                        $('#issueAssetModal').modal('hide');
                        $('#issueAssetForm')[0].reset();
                        if(assetTable){
                            assetTable.ajax.reload(null, false);
                        }
                    },
                    error: function(xhr){
                        var errMsg = 'Failed to issue asset';
                        if(xhr.responseJSON && (xhr.responseJSON.message || xhr.responseJSON.error)){
                            errMsg = xhr.responseJSON.message || xhr.responseJSON.error;
                        }
                        alert('Error: ' + errMsg);
                    },
                    complete: function(){
                        submitBtn.prop('disabled', false).text(originalBtnText);
                    }
                });
            });

            $('#addAssetModal').on('hidden.bs.modal', function(){
                $('#assetForm')[0].reset();                $('#originalAssetId').val('');                $('#originalSerialNumber').val('');
                $('#addAssetModalLabel').text('Create New Asset');
                $('#assetForm button[type="submit"]').text('Save Asset');
                $('#scrapReason').val('');
            });

            $('#scrapAssetConfirmModal').on('hidden.bs.modal', function(){
                $('#scrapReason').val('');
                pendingScrapAssetId = null;
                pendingScrapSerialNumber = null;
            });

            $('#issueAssetModal').on('hidden.bs.modal', function(){
                $('#issueAssetForm')[0].reset();
                $('#issueAssetId').val('');
            });
            
        });