extends ../layout
include ../components/modals

block content

    div.d-flex.justify-content-between.align-items-center.mb-4
        div 
            h3.fw-bold.text-dark.mb-1 Assets view 
            p.text-secondary.small.mb-0 Manage Your Assets with Valid Crendentials
        button.btn.btn-primary.btn-sm(type="button", data-bs-toggle="modal", data-bs-target="#addAssetModal") + Add New Asset 
    
    div.card.border-0.shodow-md
        div.card-body
            table#assetTable 
                thead 
                    tr 
                        th Sr. No.
                        th Make 
                        th Model 
                        th Value
                        th Branch 
                        th Purchased Date
                        th Status
                tbody 
    +formModal('addAssetModal', 'Create New Asset', 'assetForm', 'Save Asset')
        div.row.g-3
            div.col-md-6
                label.form-label Serial Number
                input.form-control.form-control-sm(type="text", name="serialNumber", required)
            div.col-md-6
                labe.form-label.small Make
                input.form-control.form-control-sm(type="text", name="make", required)
            div.col-md-6
                label.form-label.small.fw-semibold Model 
                input.form-control.form-control-sm(type="text", name="model", required)
            div.col-md-6
                label.form-label.small.fw-semibold Value (Rs)
                input.form-control.form-control-sm(type="text", name="value", required)
            div.col-md-6
                label.form-label.small.fw-semibold Branch 
                input.form-control.form-control-sm(type="text", name="branch", required)
            div.col-md-6
                label.form-label.small.fw-semibold Purchased Date
                input.form-control.form-control-sm(type="date", name="purchasedDate", required)
            div.col-md-12
                label.form-label.small.fw-semibold status
                select.form-select.form-select-sm(name="status", required)
                    option(value="in_stock", select) In_Stock 
                    option(value="issued", select) Issued 
                    option(value="scrapped", select) Scrapped

                

block scripts 
    script. 
        var assetTable;
        
        $(document).ready(function(){
            assetTable = $('#assetTable').DataTable({
                ajax:{
                    url: '/api/assets/getAssets',
                    type: 'GET',
                    dataSrc: function(json){
                        if(Array.isArray(json)){
                            return json
                        }

                        return json.assets || json.data || []
                    }
                },

                columns: [
                    {
                        data: 'serialNumber',
                        render: function(data){
                            return '<span>' + data + '</span>';
                        }
                    },

                    {
                        data: 'make',
                        render: function(data){
                            return '<span>' + data + '</span>'
                        }
                    },

                    {
                        data: 'model',
                        render: function(data){
                            return '<span>' + data + '</span>'
                        }
                    },

                    {
                        data: 'value',
                        render: function(data){
                            return '<span>' + data + '</span>'
                        }
                    },

                    {
                        data: 'branch',
                        render: function(data){
                            return '<span>' + data + '</span>'
                        }
                    },

                    {
                        data: 'purchasedDate',
                        render: function(data){
                            return '<span>' + data + '</span>'
                        }
                    },

                    {
                        data: 'status',
                        render: function(data){
                            return '<span>' + data + '</span>'
                        }
                    }
                ],

                order:[[1, 'asc']],
                language:{
                    emptyTable: 'No Assets Found',
                    loadingRecords: '<div class="spinner-border text-primary my-3" role="status"></div>'
                }
            });
        });