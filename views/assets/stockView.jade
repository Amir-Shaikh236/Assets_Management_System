extends ../layout

block content
  div.d-flex.justify-content-between.align-items-center.mb-4
    div
      h3.fw-bold.text-dark.mb-1 Stock View & Valuation
      p.text-secondary.small.mb-0 Real-time inventory overview grouped by branch (excluding scrapped hardware)
    button.btn.btn-outline-primary.btn-sm(onclick="reloadTable()")
      i.bi.bi-arrow-clockwise.me-1
      | Refresh Data

  div.row.g-3.mb-4
    div.col-md-4
      div.card.shadow-sm.border-0.border-start.border-primary.border-4.h-100
        div.card-body.p-3
          h6.card-title.text-secondary.text-uppercase.small.fw-semibold Total Branches
          p#cardTotalBranches.card-text.fs-3.fw-bold.text-dark.mb-0 -
          
    div.col-md-4
      div.card.shadow-sm.border-0.border-start.border-primary.border-4.h-100
        div.card-body.p-3
          h6.card-title.text-secondary.small.text-uppercase.fw-semibold Active Stock Items
          p#cardTotalAssets.fs-3.fw-bold.text-dark.mb-0


    div.col-md-4
      div.card.shadow-sm.border-0.border-start.border-primary.border-4.h-100
        div.card-body.p-3
          h6.card-title.text-secondary.small.text-uppercase.fw-semibold Grand Total Valuation
          p#cardTotalValuation.fs-3.fw-bold.text-success.mb-0 Rs. 0.00

  div.card.border-0.shadow-md
    div.card-body.p-4
      table#stockTable.table.table-striped.table-hover.w-100
        thead.table-light
          tr
            th Branch Office
            th.text-center Active Assets
            th.text-end Branch Valuation
        tbody
          
        tfoot.table-light.fw-bold
          tr
            td Grand Total
            td#footerTotalAssets.text-center -
            td#footerValuation.text-end.text-success Rs. 0.00

block scripts
  script.
    var stockTable;

    $(document).ready(function() {
      stockTable = $('#stockTable').DataTable({
        ajax: {
          url: '/api/assets/stockView',
          type: 'GET',
          dataSrc: function(json) {
            if (json && json.summary) {
              $('#cardTotalBranches').text(json.summary.totalBranches || 0);
              $('#cardTotalAssets, #footerTotalAssets').text(json.summary.grandTotalAssets || 0);
              
              var formattedValuation = '₹ ' + Number(json.summary.totalValuation || 0).toLocaleString('en-IN', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
              });
              
              $('#cardTotalValuation, #footerValuation').text(formattedValuation);
            }
            return json.data || [];
          }
        },
        
        columns: [
          { 
            data: 'branch',
            render: function(data) {
              return '<span class="fw-semibold text-dark"><i class="bi bi-building me-2 text-secondary"></i>' + data + '</span>';
            }
          },

          { 
            data: 'totalAssets',
            className: 'text-center',
            render: function(data) {
              return '<span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-2 border">' + data + ' Items</span>';
            }
          },

          { 
            data: 'branchValuation',
            className: 'text-end fw-bold',
            render: function(data) {
              return 'Rs. ' + Number(data || 0).toLocaleString('en-IN', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
              });
            }
          }
        ],

        order: [[0, 'asc']],
        language: {
          emptyTable: 'No active asset stock found across any branch.',
          loadingRecords: '<div class="spinner-border text-primary my-3" role="status"></div>'
        }
      });
    });

    function reloadTable() {
      if (stockTable) {
        stockTable.ajax.reload(null, false);
      }
    }