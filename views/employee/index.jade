extends ../layout
include ../components/modals

block content

    div.d-flex.justify-content-between.align-items-center.mb-4
        div 
            h3.fw-bold.text-dark.mb-1 Employees
            p.text-secondary.small.mb-0 Manage Your Employee with Valid Crendentials
        button.btn.btn-primary.btn-sm(type="button", data-bs-toggle="modal", data-bs-target="#addEmployeeModal") + Add New Employee 
    
    div.card.border-0.shodow-md
        div.card-body.p-4
            table#employeeTable.table.table-striped.table-hover.w-100
                thead.table-light
                    tr 
                        th.text-left Name
                        th.text-left Email 
                        th.text-center Department 
                        th.text-center Designation
                        th.text-center Joining Date 
                        th.text-center Status
                        th.text-right Actions
                tbody 

    +formModal('addEmployeeModal', 'Add New Employee', 'employeeForm', 'Save Employee')
        input#originalEmail(type="hidden", name="originalEmail", value="")
        div.row.g-3.pt-1
            div.col-md-6
                label.form-label.small.fw-semibold.text-secondary.mb-1 Name
                input.form-control.form-control-sm.shadow-none(type="text", name="name", required)
            div.col-md-6
                label.form-label.small.fw-semibold.text-secondary.mb-1 Email
                input.form-control.form-control-sm(type="text", name="email", required)
            div.col-md-6
                label.form-label.small.fw-semibold.text-secondary.mb-1 Department 
                input.form-control.form-control-sm(type="text", name="department", required)
            div.col-md-6
                label.form-label.small.fw-semibold.text-secondary.mb-1 Designation
                input.form-control.form-control-sm(type="text", name="designation", required)
            div.col-md-6
                label.form-label.small.fw-semibold.text-secondary.mb-1 Joining Date 
                input.form-control.form-control-sm(type="date", name="JoiningDate", required)
            div.col-md-12
                label.form-label.small.fw-semibold.text-secondary.mb-1 status
                select.form-select.form-select-sm.shadow-none(name="status", required)
                    option(value="active", selected) Active 
                    option(value="inactive") In_Active


block scripts 
    script. 
        var employeeTable;

        var API_GET_URL = '/api/employees/getEmp'
        var API_CREATE_URL = '/api/employees/addEmp'
        var API_UPDATE_URL = '/api/employees/update/'
        
        $(document).ready(function(){
            employeeTable = $('#employeeTable').DataTable({
                ajax:{
                    url: API_GET_URL,
                    type: 'GET',
                    dataSrc: function(json){
                        if(Array.isArray(json)){
                            return json
                        }

                        return json.employees || json.data || []
                    }
                },

                columns: [
                    {
                        data: 'name',
                        render: function(data){
                            return '<span class="badge bg-light text-dark border font-monospace px-2 py-1 shadow-sm">' + (data || 'N/A') + '</span>';
                        }
                    },

                    {
                        data: 'email',
                        render: function(data){
                            return '<span class="text-secondary fw-medium text-left">' + (data || '-') + '</span>'
                        }
                    },

                    {
                        data: 'department',
                        render: function(data){
                            return '<span class="text-dark fw-bold text-center">' + data + '</span>'
                        }
                    },

                    {
                        data: 'designation',
                        className: 'text-center',
                        render: function(data){
                            return '<span class="fw-semibold text-success-emphasis text-center">' + data + '</span>'
                        }
                    },

                    {
                        data: 'JoiningDate',
                        render: function(data){
                            if(!data) return '-';
                            var d = new Date(data);
                            return '<span class="text-secondary small"><i class="bi bi-calendar3 text-muted me-1 text-center"></i>' + (isNaN(d) ? data : d.toLocaleString()) + '</span>';
                        }
                    },

                    {
                        data: 'status',
                        render: function(data){
                            var statusStr = (data || 'active').toLowerCase();
                            var badgeClass = 'bg-success-subtle text-success-emphasis border border-success-subtle';
                            var icon = 'bi-check-circle-fill me-1';
                            var label = 'Active';

                            if (statusStr === 'inactive') {
                                badgeClass = 'bg-warning-subtle text-warning-emphasis border border-warning-subtle';
                                icon = 'bi-exclamation-triangle-fill me-1';
                                label = 'In_Active'

                            }

                            return '<span class="badge rounded-pill ' + badgeClass + ' px-3 py-1 fw-medium">' +
                                   '<i class="bi ' + icon + '"></i>' + label + 
                                   '</span>';
                        }
                    },

                    {
                        render: function(data){
                            return '<button class="btn btn-sm btn-light border shadow-sm btn-edit text-primary fw-medium px-3 py-1 transition-all" title="Edit Asset"><i class="bi bi-pencil-square me-1"></i> Edit </button>'
                        }
                    }
                ],

                order:[[1, 'asc']],
                language:{
                    emptyTable: 'No Employee Found',
                    loadingRecords: '<div class="spinner-border text-primary my-3" role="status"></div>'
                }
            });

            $('#employeeTable').on('click', '.btn-edit', function(){
                var tr = $(this).closest('tr');
                var rowData = employeeTable.row(tr).data();

                if(rowData){
                    $('#originalEmail').val(rowData.email)

                    $('input[name="name"]').val(rowData.name)
                    $('input[name="email"]').val(rowData.email);
                    $('input[name="department"]').val(rowData.department)
                    $('input[name="designation"]').val(rowData.designation)

                    if(rowData.JoiningDate){
                        var d = new Date(rowData.JoiningDate)
                        if(!isNaN(d)){
                            var formatDate = d.toISOString().split('T')[0];
                            $('input[name="JoiningDate"]').val(formatDate);
                        }else{
                            $('input[name="JoiningDate"]').val(rowData.JoiningDate);
                        }
                    }

                    $('select[name="status"]').val(rowData.status);

                    $('#addEmployeeModalLabel').text('Update Employee Details');
                    $('#employeeForm button[type="submit"]').text('Update Employee');
                    $('#addEmployeeModal').modal('show');
                }
            });


            $('#addEmployeeModal').on('hidden.bs.modal', function(){
                $('#employeeForm')[0].reset();
                $('#originalEmail').val('')
                $('#addEmployeeModalLabel').text('Add New Employee')
                $('#employeeForm button[type="submit"]').text('Add Employee');
            });


            $('#employeeForm').on('submit', function(e){
                e.preventDefault();

                var Email = $('#originalEmail').val();
                var isUpdate = (Email && Email.trim() !== '');

                var formatDataList = $(this).serializeArray();
                var payload = {};
                $.each(formatDataList, function(i, field){
                    if(field.name !== 'originalEmail'){
                        payload[field.name] = field.value;
                    }
                });

                var requestUrl = isUpdate ? (API_UPDATE_URL + encodeURIComponent(Email)) : API_CREATE_URL;
                var requestMethod = isUpdate ? 'PUT' : 'POST'
                var submitBtn = $(this).find('button[type="submit"]');
                var originalBtnText = submitBtn.text();
                submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Saving...');


                $.ajax({
                    url: requestUrl,
                    type: requestMethod,
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function(response){
                        $('#addEmployeeModal').modal('hide');
                        if(employeeTable){
                            employeeTable.ajax.reload(null, false);
                        }
                    },

                    error: function(xhr, status, error){
                        var errMsg = 'Failed to process asset request'
                        if(xhr.responseJSON && (xhr.responseJSON.message || xhr.responseJSON.error)){
                            errMsg = xhr.responseJSON.message || xhr.responseJSON.error;
                        }
                        alert('Error ' + errMsg);
                    },

                    complete: function(){
                        submitBtn.prop('disabled', false).text(originalBtnText);
                    }
                });

            });
        });